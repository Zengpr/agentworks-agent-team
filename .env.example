# 复制为 .env 后按需填写。

# LLM 模式：mock = 离线确定性演示（默认，无需任何 Key）；real = 接真实模型
AGENT_LLM=mock

# real 模式配置（OpenAI 兼容端点：DeepSeek / OpenAI / Ollama / 任何兼容服务）
# DeepSeek 示例：
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_API_KEY=sk-your-key-here
# AGENT_MODEL=deepseek-chat

# Ollama 本地示例（无需 Key）：
# AGENT_BASE_URL=http://localhost:11434/v1
# AGENT_API_KEY=ollama
# AGENT_MODEL=llama3.1
